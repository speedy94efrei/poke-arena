# Copier en deploy/.env sur le serveur, puis remplir. Ce fichier n'est jamais commité.

# Domaines publics, chacun avec un enregistrement DNS A (et AAAA) vers le serveur. Caddy obtient leurs certificats HTTPS.
COMBAT_DOMAIN=combat.example.com
API_DOMAIN=api.example.com

# Secret partagé entre le serveur de combat et l'API : une longue valeur aléatoire, par exemple « openssl rand -hex 32 ».
ARENE_SECRET=

# Clé de chiffrement de Laravel : « base64: » suivi de « openssl rand -base64 32 ». Ne plus la changer ensuite.
APP_KEY=
